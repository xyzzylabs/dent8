{
  "name": "dent8",
  "version": "0.8.0",
  "description": "A memory firewall for coding agents — thin TypeScript SDK over the dent8 CLI's JSON contract.",
  "keywords": [
    "agent",
    "memory",
    "provenance",
    "firewall",
    "mcp",
    "tools",
    "ai-sdk",
    "langchain"
  ],
  "license": "(Apache-2.0 OR MIT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyzzylabs/dent8.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://xyzzylabs.github.io/dent8/",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3",
    "ai": ">=5"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^0.3",
    "@types/node": "^26.1.1",
    "ai": "^5",
    "typescript": "^5.5"
  }
}
