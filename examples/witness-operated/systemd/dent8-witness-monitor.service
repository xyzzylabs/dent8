# One-shot monitor: re-verify externally published heads against the live log with only the
# PUBLIC key. Pair with the .timer; a tamper/rollback verdict fails the unit (exit 1), which
# is your alert hook (OnFailure=, or scrape failed units).
#   /etc/dent8/monitor.env:
#     DENT8_STORE_URL=postgres://…
#     DENT8_WITNESS_PUBKEY=/etc/dent8/witness.key.pub
#     PUBLISHED_HEADS=/var/lib/dent8/published-heads.jsonl   (synced from the publication channel)
#     PUBLISHED_GRANTS=/var/lib/dent8/published-grant-heads.jsonl   (optional, when signed identity is used)
[Unit]
Description=dent8 witness published-heads verification

[Service]
Type=oneshot
User=dent8
EnvironmentFile=/etc/dent8/monitor.env
ExecStart=/bin/sh -c 'if [ -n "${PUBLISHED_GRANTS:-}" ] && [ -f "$PUBLISHED_GRANTS" ]; then /usr/local/bin/dent8 --output json witness verify-published "$PUBLISHED_HEADS" --grants "$PUBLISHED_GRANTS"; else /usr/local/bin/dent8 --output json witness verify-published "$PUBLISHED_HEADS"; fi'
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
